# Copy this file to .env and adjust values as needed

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/library_management

# MongoDB Atlas (cloud) example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/library_management

# Fine settings
FINE_PER_DAY=5
BORROW_PERIOD_DAYS=14

# CORS - frontend origin allowed to call this API
CLIENT_ORIGIN=http://127.0.0.1:5500
